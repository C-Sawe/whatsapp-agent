WHATSAPP_TOKEN=your_system_user_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
VERIFY_TOKEN=your_custom_verify_token_here
GOOGLE_APPLICATION_CREDENTIALS=service_account.json
SPREADSHEET_ID=your_google_sheet_id_here
GROQ_API_KEY=your_groq_api_key_here

# Protrack365 telemetry
PROTRACK_ACCOUNT=your_protrack_account
PROTRACK_PASSWORD=your_protrack_password
PROTRACK_API_BASE=http://api.protrack365.com

# Postgres (used by main.py / dashboard_app.py / sync_inventory.py)
DB_HOST=localhost
DB_USER=evolution_user
DB_PASS=set_a_strong_password_here
DB_NAME=evolution

# Auth — required, no insecure defaults are baked into the code
JWT_SECRET=generate_a_long_random_string_here
EVOLUTION_API_KEY=must_match_the_evolution_api_AUTHENTICATION_API_KEY
ADMIN_USERNAME=your_admin_login_username
ADMIN_PASSWORD=your_admin_login_password

# Optional: comma-separated list of origins allowed to call this API
# cross-origin (e.g. a Vite dev server). Leave unset in production if the
# frontend is served from this same backend.
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5180

# Optional: once set, /webhook/evolution requires this value in the
# "apikey" header on incoming webhook requests (configure the same header
# in Evolution API's webhook settings). Leave unset to keep today's
# behavior (no verification) until you've wired that up.
# WEBHOOK_VERIFY_SECRET=
